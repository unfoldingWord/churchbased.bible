---
import Base from '../../layouts/Base.astro';
import SubHero from '../SubHero.astro';
import MediaText from '../MediaText.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'training');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
---

<Base locale={locale} slug="training" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.hero.title)}>
  <SubHero pageTitle={t.title} heroTitle={t.hero.title} image={t.hero.image} />

  <section class="py-sect">
    <div class="mx-auto max-w-content px-7">
      <p set:html={t.intro} />
      <img class="mx-auto my-card w-full max-w-[560px]" src={t.cycleImage} alt="" loading="lazy" />
      <h2 class="text-center" set:html={t.resourcesHeading} />
      <p set:html={t.resourcesIntro} />
    </div>
  </section>

  <section>
    <div class="mx-auto grid max-w-content gap-card px-7">
      {
        t.resources.map((card: any, i: number) => (
          <MediaText image={card.image} media={i % 2 ? 'end' : 'start'} tone="cream">
            <h2 class="text-center" set:html={card.heading} />
            <p class="text-center" set:html={card.body} />
            <p class="flex flex-wrap justify-center gap-3 text-center">
              {card.buttons.map((b: any) => {
                const external = b.href.startsWith('http');
                return (
                  <a
                    class="button button--dark"
                    href={b.href}
                    target={external ? '_blank' : undefined}
                    rel={external ? 'noopener noreferrer' : undefined}
                  >
                    {b.label}
                  </a>
                );
              })}
            </p>
          </MediaText>
        ))
      }
    </div>
  </section>

  <div class="mx-auto max-w-content px-7"><hr class="my-card border-0 border-t border-[#d8d2c6]" /></div>

  <section class="py-sect">
    <div class="mx-auto max-w-[880px] px-7">
      <h2 set:html={t.faqHeading} />
      {
        t.faqs.map((faq: any) => (
          <details class="border-b border-[#e2ddd3] py-[0.9em]">
            <summary class="cursor-pointer font-heading text-[17px] font-semibold" set:html={faq.q} />
            {faq.a.map((p: string) => (
              <p class="mt-[0.8em] mb-0 text-base" set:html={p} />
            ))}
          </details>
        ))
      }
    </div>
  </section>
</Base>
