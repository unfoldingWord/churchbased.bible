---
import Base from '../../layouts/Base.astro';
import SubHero from '../SubHero.astro';
import MediaText from '../MediaText.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'training');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
---

<Base locale={locale} slug="training" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.hero.title)}>
  <SubHero pageTitle={t.title} heroTitle={t.hero.title} image={t.hero.image} />

  <section class="section">
    <div class="container narrow">
      <p set:html={t.intro} />
      <img class="cycle" src={t.cycleImage} alt="" loading="lazy" />
      <h2 class="centered" set:html={t.resourcesHeading} />
      <p set:html={t.resourcesIntro} />
    </div>
  </section>

  <section class="cards">
    <div class="container cards__list">
      {
        t.resources.map((card: any, i: number) => (
          <MediaText image={card.image} media={i % 2 ? 'end' : 'start'} tone="cream">
            <h2 class="centered" set:html={card.heading} />
            <p class="centered" set:html={card.body} />
            <p class="cards__cta">
              {card.buttons.map((b: any) => (
                <a class="button button--dark" href={b.href} rel={b.href.startsWith('http') ? 'noopener' : undefined}>
                  {b.label}
                </a>
              ))}
            </p>
          </MediaText>
        ))
      }
    </div>
  </section>

  <div class="container"><hr class="separator" /></div>

  <section class="section">
    <div class="container narrow">
      <h2 set:html={t.faqHeading} />
      {
        t.faqs.map((faq: any) => (
          <details class="faq">
            <summary set:html={faq.q} />
            {faq.a.map((p: string) => (
              <p set:html={p} />
            ))}
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 880px;
  }
  .centered {
    text-align: center;
  }
  .cycle {
    width: min(560px, 100%);
    margin-inline: auto;
    margin-block: var(--space-4);
  }
  .cards__list {
    display: grid;
    gap: var(--space-4);
  }
  .cards__cta {
    text-align: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75em;
    justify-content: center;
  }
  .separator {
    border: 0;
    border-top: 1px solid #d8d2c6;
    margin-block: var(--space-4);
  }
  .faq {
    border-block-end: 1px solid #e2ddd3;
    padding-block: 0.9em;
  }
  .faq summary {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 17px;
    cursor: pointer;
  }
  .faq p {
    margin-block: 0.8em 0;
    font-size: 15px;
  }
</style>
