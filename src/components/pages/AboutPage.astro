---
import Base from '../../layouts/Base.astro';
import SubHero from '../SubHero.astro';
import MediaText from '../MediaText.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'about');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
---

<Base locale={locale} slug="about" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.hero.title)}>
  <SubHero pageTitle={t.title} heroTitle={t.hero.title} image={t.hero.image} />

  <section class="py-sect text-center">
    <div class="mx-auto max-w-content px-7">
      <h2 set:html={t.power.heading} />
      <p class="mx-auto max-w-[46em]" set:html={t.power.body} />
      <video class="mt-card aspect-video w-full bg-black" src={t.power.video} controls preload="metadata"></video>
    </div>
  </section>

  <section class="py-sect text-center">
    <div class="mx-auto max-w-content px-7">
      <p class="mx-auto mb-[0.4em] max-w-[46em] font-heading text-[clamp(1.2rem,1rem+0.9vw,1.55rem)] font-semibold" set:html={t.demand.line1} />
      <h2 set:html={t.demand.line2} />
    </div>
  </section>

  <section>
    <div class="mx-auto grid max-w-content gap-card px-7">
      {
        t.growth.map((card: any, i: number) => (
          <MediaText image={card.image} media={i % 2 ? 'start' : 'end'} tone="cream" aspect="2 / 1">
            <p set:html={card.body} />
          </MediaText>
        ))
      }
    </div>
  </section>

  <section class="py-sect text-center">
    <div class="mx-auto max-w-content px-7"><h2 set:html={t.paradigmsHeading} /></div>
  </section>

  <section>
    <div class="mx-auto grid max-w-content gap-card px-7">
      {
        t.paradigms.map((card: any, i: number) => (
          <MediaText image={card.image} media={i % 2 ? 'start' : 'end'} tone="cream" aspect="2 / 1">
            <p set:html={card.body} />
          </MediaText>
        ))
      }
    </div>
  </section>

  <section class="py-sect text-center">
    <div class="mx-auto max-w-content px-7"><h2 set:html={t.conditionsHeading} /></div>
  </section>

  <section>
    <div class="mx-auto grid max-w-content gap-card px-7">
      {
        t.conditions.map((group: any, i: number) => (
          <MediaText image={group.image} media={i % 2 ? 'end' : 'start'} tone="cream" mediaFrac="minmax(220px, 0.45fr)">
            <div class="grid grid-cols-1 gap-7 sm:grid-cols-2">
              {group.items.map((item: any) => (
                <div class="text-center">
                  <img src={item.icon} alt="" loading="lazy" class="mx-auto mb-[0.8em] h-12 w-auto" />
                  <p class="mb-[0.4em]" set:html={item.title} />
                  <p class="m-0 text-[14px]" set:html={item.body} />
                </div>
              ))}
            </div>
          </MediaText>
        ))
      }
    </div>
  </section>

  <div class="mx-auto max-w-content px-7"><hr class="my-card border-0 border-t border-[#d8d2c6]" /></div>

  <section class="py-sect text-center">
    <div class="mx-auto max-w-content px-7"><h2 set:html={t.nextHeading} /></div>
  </section>

  <section>
    <div class="mx-auto grid max-w-content gap-card px-7">
      {
        t.next.map((card: any, i: number) => (
          <MediaText image={card.image} media={i % 2 ? 'start' : 'end'} tone="cream" aspect="2 / 1">
            <p set:html={card.body} />
            <p class="mt-6 text-center">
              <a class="button button--dark" href={card.cta.href}>
                {card.cta.label}
              </a>
            </p>
          </MediaText>
        ))
      }
    </div>
  </section>
</Base>
