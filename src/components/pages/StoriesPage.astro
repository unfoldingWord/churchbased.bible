---
import Base from '../../layouts/Base.astro';
import MediaText from '../MediaText.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'stories');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
---

<Base locale={locale} slug="stories" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.hero.line1)}>
  <div class="container">
    <h1 class="page-title">{t.title}</h1>
  </div>

  <section class="stories-hero">
    <video src={t.hero.video} autoplay muted loop playsinline aria-hidden="true"></video>
    <div class="stories-hero__scrim"></div>
    <div class="stories-hero__content">
      <h2 set:html={t.hero.line1} />
      <h2 class="stories-hero__strong" set:html={t.hero.line2} />
    </div>
  </section>

  <section class="cards section">
    <div class="container cards__list">
      {
        t.stories.map((story: any, i: number) => (
          <MediaText image={story.image} media={i % 2 ? 'start' : 'end'} tone="cream">
            <h2 set:html={story.heading} />
            <p class="story-location" set:html={story.location} />
            <p set:html={story.body} />
            <p>
              <a class="read-more" href={story.pdf} target="_blank" rel="noopener">
                <mark>{story.readMore}</mark>
                <img src="/images/uploads/2024/07/external-link-1.svg" alt="" width="18" height="18" />
              </a>
            </p>
          </MediaText>
        ))
      }
    </div>
  </section>

  <div class="container"><hr class="separator" /></div>

  <section class="section coming-soon">
    <div class="container">
      <h2 set:html={t.comingSoon.heading} />
      <p set:html={t.comingSoon.body} />
    </div>
  </section>
</Base>

<style>
  .page-title {
    font-size: clamp(1.6rem, 1.4rem + 1vw, 2rem);
    margin-block: 1.6em 0.9em;
  }
  .stories-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-6);
    color: #fff;
    text-align: center;
  }
  .stories-hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .stories-hero__scrim {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.45);
  }
  .stories-hero__content {
    position: relative;
    max-width: 900px;
    margin-inline: auto;
    padding-inline: var(--space-3);
  }
  .stories-hero h2 {
    color: #fff;
    margin-block-end: 0.3em;
  }
  .cards__list {
    display: grid;
    gap: var(--space-4);
  }
  .story-location {
    margin-block-start: -0.6em;
    opacity: 0.85;
  }
  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    text-decoration: none;
    font-weight: 600;
  }
  .read-more mark {
    background: transparent;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .separator {
    border: 0;
    border-top: 1px solid #d8d2c6;
    margin-block: var(--space-4);
  }
  .coming-soon {
    text-align: center;
  }
  .coming-soon p {
    max-width: 44em;
    margin-inline: auto;
  }
</style>
