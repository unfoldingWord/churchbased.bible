---
import Base from '../../layouts/Base.astro';
import MediaText from '../MediaText.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'stories');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
---

<Base locale={locale} slug="stories" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.hero.line1)}>
  <div class="mx-auto max-w-content px-7">
    <h1 class="mt-[1.6em] mb-[0.9em] text-[clamp(1.6rem,1.4rem+1vw,2rem)]">{t.title}</h1>
  </div>

  <section class="relative overflow-hidden py-band text-center text-white">
    <video src={t.hero.video} autoplay muted loop playsinline aria-hidden="true" class="absolute inset-0 h-full w-full object-cover"
    ></video>
    <div class="absolute inset-0 bg-black/28"></div>
    <div class="relative mx-auto max-w-[900px] px-7">
      <h2 class="mb-[0.3em] text-white" set:html={t.hero.line1} />
      <h2 class="mb-[0.3em] text-white" set:html={t.hero.line2} />
    </div>
  </section>

  <section class="py-sect">
    <div class="mx-auto grid max-w-content gap-card px-7">
      {
        t.stories.map((story: any, i: number) => (
          <MediaText image={story.image} media={i % 2 ? 'start' : 'end'} tone="cream">
            <h2 set:html={story.heading} />
            <p class="mt-[-0.6em] opacity-85" set:html={story.location} />
            <p set:html={story.body} />
            <p>
              <a class="button button--dark" href={story.pdf} target="_blank" rel="noopener noreferrer">
                {story.readMore}
              </a>
            </p>
          </MediaText>
        ))
      }
    </div>
  </section>

  <div class="mx-auto max-w-content px-7"><hr class="my-card border-0 border-t border-[#d8d2c6]" /></div>

  <section class="py-sect text-center">
    <div class="mx-auto max-w-content px-7">
      <h2 set:html={t.comingSoon.heading} />
      <p class="mx-auto max-w-[44em]" set:html={t.comingSoon.body} />
    </div>
  </section>
</Base>
