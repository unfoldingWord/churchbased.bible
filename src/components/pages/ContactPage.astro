---
import Base from '../../layouts/Base.astro';
import SubHero from '../SubHero.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'contact');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
const f = t.form;
// first option is the placeholder ("Select An Option")
const [placeholderOption, ...subjects] = f.subjectOptions;
const CONTACT_EMAIL = 'churchbased.bible@unfoldingword.org';

const inputClasses =
  'w-full rounded border border-[#c9c4bb] bg-white px-3 py-2 text-base aria-[invalid=true]:border-error aria-[invalid=true]:outline-error';
const labelClasses = 'mb-1.5 block font-semibold';
const errorClasses = 'mt-1 block min-h-[1.2em] text-[0.85em] text-error';
---

<Base locale={locale} slug="contact" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.hero.title)}>
  <SubHero pageTitle={t.title} heroTitle={t.hero.title} image={t.hero.image} />

  <section class="py-sect">
    <div class="mx-auto max-w-[760px] px-7">
      <p class="mx-auto max-w-[46em] text-center text-[clamp(1.05rem,1rem+0.4vw,1.25rem)] font-medium" set:html={t.intro} />
      <h2 class="mt-[0.8em] mb-card text-center" set:html={t.matter} />

      <form
        class="contact-form rounded-md bg-white p-[clamp(1.5rem,4vw,3rem)] shadow-[0_12px_32px_rgb(0_0_0/0.16)]"
        method="post"
        action="/api/contact"
        novalidate
        data-success={f.success}
        data-error={ui.strings.formError}
        data-error-required={f.errorRequired}
        data-error-email={f.errorEmail}
      >
        <p class="absolute -start-[9999px]">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </p>
        <input type="hidden" name="locale" value={locale} />
        <div class="mb-7">
          <label class={labelClasses} for="cf-name">{f.name} <span class="text-[0.85em] font-normal opacity-70">{f.required}</span></label>
          <input class={inputClasses} id="cf-name" name="name" type="text" required autocomplete="name" aria-describedby="cf-name-error" />
          <span class={errorClasses} id="cf-name-error" role="alert"></span>
        </div>
        <div class="mb-7">
          <label class={labelClasses} for="cf-email">{f.email} <span class="text-[0.85em] font-normal opacity-70">{f.required}</span></label>
          <input class={inputClasses} id="cf-email" name="email" type="email" required autocomplete="email" aria-describedby="cf-email-error" />
          <span class={errorClasses} id="cf-email-error" role="alert"></span>
        </div>
        <div class="mb-7">
          <label class={labelClasses} for="cf-subject">{f.subject} <span class="text-[0.85em] font-normal opacity-70">{f.required}</span></label>
          <select class={inputClasses} id="cf-subject" name="subject" required aria-describedby="cf-subject-error">
            <option value="" selected disabled>{placeholderOption}</option>
            {subjects.map((s: string) => <option value={s}>{s}</option>)}
          </select>
          <span class={errorClasses} id="cf-subject-error" role="alert"></span>
        </div>
        <div class="mb-7">
          <label class={labelClasses} for="cf-message">{f.message}</label>
          <textarea class:list={[inputClasses, 'resize-y']} id="cf-message" name="message" rows="6"></textarea>
        </div>
        <p class="m-0 text-center">
          <button class="button button--dark" type="submit">{f.submit}</button>
        </p>
        <p class="form-status mt-4 min-h-[1.4em] text-center" role="status" aria-live="polite"></p>
      </form>

      <p class="mt-7 text-center text-[0.9em]">
        {f.fallbackLead} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  if (form) {
    const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    const msgRequired = form.dataset.errorRequired ?? 'This field is required.';
    const msgEmail = form.dataset.errorEmail ?? 'Please enter a valid email address.';

    const controls = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
        'input[required], select[required], input[type=email]'
      )
    ).filter((el) => el.name !== 'website');

    const errorFor = (el: Element) =>
      form.querySelector<HTMLElement>(`#${el.getAttribute('aria-describedby')}`);

    const validateField = (el: HTMLInputElement | HTMLSelectElement) => {
      const box = errorFor(el);
      let error = '';
      if (el.hasAttribute('required') && !el.value.trim()) error = msgRequired;
      else if (el.type === 'email' && el.value.trim() && !EMAIL_RE.test(el.value.trim()))
        error = msgEmail;
      if (box) box.textContent = error;
      el.setAttribute('aria-invalid', error ? 'true' : 'false');
      return !error;
    };

    // Clear a field's error as soon as the user corrects it.
    controls.forEach((el) => {
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') validateField(el);
      });
      el.addEventListener('blur', () => validateField(el));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.form-status')!;

      let firstInvalid: HTMLElement | null = null;
      for (const el of controls) {
        if (!validateField(el) && !firstInvalid) firstInvalid = el;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        controls.forEach((el) => el.setAttribute('aria-invalid', 'false'));
        status.textContent = form.dataset.success ?? 'Thank you!';
      } catch {
        status.textContent = form.dataset.error ?? 'Something went wrong. Please try again.';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
