---
import Base from '../../layouts/Base.astro';
import SubHero from '../SubHero.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'contact');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
const f = t.form;
// first option is the placeholder ("Select An Option")
const [placeholderOption, ...subjects] = f.subjectOptions;
const CONTACT_EMAIL = 'churchbased.bible@unfoldingword.org';
---

<Base locale={locale} slug="contact" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.hero.title)}>
  <SubHero pageTitle={t.title} heroTitle={t.hero.title} image={t.hero.image} />

  <section class="section contact">
    <div class="container narrow">
      <p class="contact__intro" set:html={t.intro} />
      <h2 class="contact__matter" set:html={t.matter} />

      <form
        class="contact-form"
        method="post"
        action="/api/contact"
        novalidate
        data-success={f.success}
        data-error={ui.strings.formError}
        data-error-required={f.errorRequired}
        data-error-email={f.errorEmail}
      >
        <p class="hp">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </p>
        <input type="hidden" name="locale" value={locale} />
        <div class="field">
          <label for="cf-name">{f.name} <span class="req">{f.required}</span></label>
          <input id="cf-name" name="name" type="text" required autocomplete="name" aria-describedby="cf-name-error" />
          <span class="field-error" id="cf-name-error" role="alert"></span>
        </div>
        <div class="field">
          <label for="cf-email">{f.email} <span class="req">{f.required}</span></label>
          <input id="cf-email" name="email" type="email" required autocomplete="email" aria-describedby="cf-email-error" />
          <span class="field-error" id="cf-email-error" role="alert"></span>
        </div>
        <div class="field">
          <label for="cf-subject">{f.subject} <span class="req">{f.required}</span></label>
          <select id="cf-subject" name="subject" required aria-describedby="cf-subject-error">
            <option value="" selected disabled>{placeholderOption}</option>
            {subjects.map((s: string) => <option value={s}>{s}</option>)}
          </select>
          <span class="field-error" id="cf-subject-error" role="alert"></span>
        </div>
        <div class="field">
          <label for="cf-message">{f.message}</label>
          <textarea id="cf-message" name="message" rows="6"></textarea>
        </div>
        <p class="submit-row">
          <button class="button button--dark" type="submit">{f.submit}</button>
        </p>
        <p class="form-status" role="status" aria-live="polite"></p>
      </form>

      <p class="contact__fallback">
        {f.fallbackLead} <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .narrow {
    max-width: 760px;
  }
  .contact__intro {
    text-align: center;
    font-weight: 500;
    font-size: clamp(1.05rem, 1rem + 0.4vw, 1.25rem);
    max-width: 46em;
    margin-inline: auto;
  }
  .contact__matter {
    text-align: center;
    margin-block: 0.8em var(--space-4);
  }
  .contact-form {
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.16);
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .field {
    margin-block-end: var(--space-3);
  }
  .field label {
    display: block;
    font-weight: 600;
    margin-block-end: 0.4em;
  }
  .req {
    font-weight: 400;
    font-size: 0.85em;
    opacity: 0.7;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    padding: 0.6em 0.8em;
    border: 1px solid #c9c4bb;
    border-radius: 4px;
    background: #fff;
  }
  .field textarea {
    resize: vertical;
  }
  .field :is(input, select)[aria-invalid='true'] {
    border-color: #b3261e;
    outline-color: #b3261e;
  }
  .field-error {
    display: block;
    min-height: 1.2em;
    margin-block-start: 0.3em;
    color: #b3261e;
    font-size: 0.85em;
  }
  .submit-row {
    text-align: center;
    margin: 0;
  }
  .form-status {
    text-align: center;
    margin-block-start: var(--space-2);
    min-height: 1.4em;
  }
  .contact__fallback {
    text-align: center;
    margin-block-start: var(--space-3);
    font-size: 0.9em;
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  if (form) {
    const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    const msgRequired = form.dataset.errorRequired ?? 'This field is required.';
    const msgEmail = form.dataset.errorEmail ?? 'Please enter a valid email address.';

    const controls = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>(
        'input[required], select[required], input[type=email]'
      )
    ).filter((el) => el.name !== 'website');

    const errorFor = (el: Element) =>
      form.querySelector<HTMLElement>(`#${el.getAttribute('aria-describedby')}`);

    const validateField = (el: HTMLInputElement | HTMLSelectElement) => {
      const box = errorFor(el);
      let error = '';
      if (el.hasAttribute('required') && !el.value.trim()) error = msgRequired;
      else if (el.type === 'email' && el.value.trim() && !EMAIL_RE.test(el.value.trim()))
        error = msgEmail;
      if (box) box.textContent = error;
      el.setAttribute('aria-invalid', error ? 'true' : 'false');
      return !error;
    };

    // Clear a field's error as soon as the user corrects it.
    controls.forEach((el) => {
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') validateField(el);
      });
      el.addEventListener('blur', () => validateField(el));
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector('.form-status')!;

      let firstInvalid: HTMLElement | null = null;
      for (const el of controls) {
        if (!validateField(el) && !firstInvalid) firstInvalid = el;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      status.textContent = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        controls.forEach((el) => el.setAttribute('aria-invalid', 'false'));
        status.textContent = form.dataset.success ?? 'Thank you!';
      } catch {
        status.textContent = form.dataset.error ?? 'Something went wrong. Please try again.';
      } finally {
        btn.disabled = false;
      }
    });
  }
</script>
