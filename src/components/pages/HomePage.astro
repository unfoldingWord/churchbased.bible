---
import Base from '../../layouts/Base.astro';
import Header from '../Header.astro';
import MediaText from '../MediaText.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'home');
const ui = content(locale, 'ui');
const plainTitle = t.hero.title.replace(/<[^>]+>/g, '');
// Full-width hero wants the full-size cover; the WebP rendition is 84 KB
// vs the multi-hundred-KB WP original.
const heroImage = '/images/uploads/2025/11/CBBT-Website-Cover.webp';
---

<Base locale={locale} slug="home" title={`${ui.siteTitle} | ${plainTitle}`} description={plainTitle} bareHeader>
  <link rel="preload" as="image" href={heroImage} fetchpriority="high" slot="head" />
  <section
    class="relative flex min-h-[88vh] flex-col justify-center bg-cover bg-center before:absolute before:inset-0 before:bg-black/50"
    style={`background-image:url('${heroImage}')`}
  >
    <Header locale={locale} ui={ui} slug="home" variant="overlay" />
    <div class="relative mx-auto w-full max-w-[1140px] px-7 text-center text-white">
      <img class="mx-auto w-20" src="/images/uploads/2025/11/CBBT-Logo.png" alt="" width="120" height="120" />
      <h1 class="mt-[1.4em] mb-[0.9em] text-2xl text-balance text-white" set:html={t.hero.title} />
      <a class="button" href={t.hero.cta.href}>{t.hero.cta.label}</a>
    </div>
  </section>

  <section class="py-sect">
    <div class="mx-auto max-w-content px-7">
      <h2 class="mb-sect text-center text-2xl" set:html={t.story.title} />
      <div class="grid grid-cols-1 gap-x-7 gap-y-12 md:grid-cols-2">
        {
          t.story.steps.map((step: any, i: number) => {
            const feature = i === t.story.steps.length - 1;
            return (
              <div
                class:list={[
                  // Matches the source: square image filling half the cell,
                  // text beside it.
                  'grid grid-cols-1 items-start gap-6 sm:grid-cols-2',
                  // Final step spans the full width with a large image — the
                  // emphatic close of the Zeme story (as on the original).
                  feature && 'md:col-span-2 md:gap-card',
                ]}
                data-reveal
              >
                <img
                  src={step.image}
                  alt=""
                  loading="lazy"
                  class:list={['w-full object-cover', feature ? 'aspect-[3/2]' : 'aspect-square']}
                />
                <div>
                  <h3 class:list={[feature ? 'text-2xl' : 'text-lg', 'mb-[0.5em]']} set:html={step.heading} />
                  <p class:list={['m-0', feature ? 'text-lg leading-[1.55]' : 'text-base']} set:html={step.body} />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="bg-ink py-sect text-white">
    <div class="mx-auto max-w-content px-7">
      <blockquote class="m-0 text-center">
        <p
          class="mx-auto my-0 font-heading text-2xl leading-[1.25] font-semibold [&_mark]:bg-transparent [&_mark]:text-inherit"
          set:html={t.quote}
        />
      </blockquote>
    </div>
  </section>

  <section class="py-sect">
    <div class="mx-auto max-w-content px-7">
      <h2 class="mb-sect text-center text-2xl" set:html={t.how.title} />
      <div class="grid grid-cols-1 gap-card md:grid-cols-3">
        {
          t.how.steps.map((step: any) => (
            <div data-reveal>
              <img src={step.image} alt="" loading="lazy" class="mb-7 h-[110px] w-auto" />
              <h3 class="text-xl" set:html={step.heading} />
              <p class="text-base" set:html={step.body} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-sect">
    <div class="mx-auto max-w-content px-7">
      <MediaText image={t.fromChurch.image} media="end" tone="cream" mediaFrac="0.67fr">
        <h2 class="text-center text-balance" set:html={t.fromChurch.heading} />
        <p><strong set:html={t.fromChurch.lead} /></p>
        <p set:html={t.fromChurch.body} />
        <p class="mt-4 text-center">
          <a class="button button--dark" href={t.fromChurch.cta.href}>{t.fromChurch.cta.label}</a>
        </p>
      </MediaText>
    </div>
  </section>

  <section class="relative overflow-hidden py-band text-white">
    <video
      data-src={t.finalCta.video}
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
      class="absolute inset-0 h-full w-full object-cover"></video>
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative mx-auto max-w-content px-7">
      <div class="border border-white/75 p-[clamp(2rem,4vw,3.25rem)]">
        <h2 class="max-w-[20em]" set:html={t.finalCta.heading} />
        <p class="mb-7 max-w-[44em]" set:html={t.finalCta.body} />
        <a class="button" href={t.finalCta.cta.href}>{t.finalCta.cta.label}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  document.documentElement.classList.add('js');
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      }
    },
    { threshold: 0.2 }
  );
  document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

  // The CTA background video is far below the fold — don't spend bandwidth
  // on it until the section approaches the viewport.
  const lazyVideo = document.querySelector<HTMLVideoElement>('video[data-src]');
  if (lazyVideo) {
    const vio = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          lazyVideo.src = lazyVideo.dataset.src!;
          lazyVideo.play().catch(() => {});
          vio.disconnect();
        }
      },
      { rootMargin: '600px' }
    );
    vio.observe(lazyVideo);
  }
</script>
