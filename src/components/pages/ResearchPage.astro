---
import Base from '../../layouts/Base.astro';
import SubHero from '../SubHero.astro';
import { content } from '../../i18n/content';

interface Props {
  locale: string;
}
const { locale } = Astro.props;
const t = content(locale, 'research');
const ui = content(locale, 'ui');
const plain = (s: string) => s.replace(/<[^>]+>/g, '');
---

<Base locale={locale} slug="research" title={`${t.title} – ${ui.siteTitle}`} description={plain(t.intro).slice(0, 160)}>
  <SubHero pageTitle={t.title} heroTitle={t.hero.title} image={t.hero.image} />

  <section class="py-sect">
    <div class="mx-auto max-w-[980px] px-7">
      <p set:html={t.intro} />
      <hr class="my-card border-0 border-t border-[#d8d2c6]" />
      <h2 set:html={t.papersHeading} />
      <div class="mt-card grid gap-card">
        {
          t.papers.map((paper: any) => (
            <div class="grid grid-cols-1 items-center gap-7 sm:grid-cols-[220px_1fr]">
              <img src={paper.image} alt="" loading="lazy" class="w-full shadow-[0_6px_18px_rgb(0_0_0/0.18)]" />
              <div>
                <p set:html={paper.body} />
                <p class="mt-[0.9em] flex flex-wrap gap-2.5">
                  {paper.files.map((f: any) => {
                    const external = f.href.startsWith('http');
                    return (
                      <a
                        class="button button--dark button--sm"
                        href={f.href}
                        target={external ? '_blank' : undefined}
                        rel={external ? 'noopener noreferrer' : undefined}
                      >
                        {f.label}
                      </a>
                    );
                  })}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="pb-sect">
    <div class="mx-auto max-w-content px-7">
      <h2 set:html={t.videosHeading} />
      <div class="mt-card grid gap-sect">
        {
          t.videos.map((v: any, i: number) => {
            // "Reasons" (2nd) video shows on the right instead of the left,
            // keeping the video in the wide column.
            const reverse = i === 1;
            return (
              <div
                class:list={[
                  'grid grid-cols-1 items-center gap-card rounded-md bg-cream-light p-card shadow-[0_10px_26px_rgb(0_0_0/0.12)]',
                  reverse ? 'md:grid-cols-[1fr_1.6fr]' : 'md:grid-cols-[1.6fr_1fr]',
                ]}
              >
                <video
                  src={v.video}
                  controls
                  preload="metadata"
                  class:list={['aspect-video w-full bg-black', reverse && 'md:order-2']}
                />
                <div>
                  <h3 set:html={v.heading} />
                  <p set:html={v.body} />
                </div>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>
