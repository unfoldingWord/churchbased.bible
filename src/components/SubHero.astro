---
/** Subpage opener: big page title on white, then a full-bleed split hero —
 *  photo on one side, warm-gray panel with a white heading on the other. */
interface Props {
  pageTitle: string;
  heroTitle: string;
  image?: string | null;
}
const { pageTitle, heroTitle, image } = Astro.props;
---

<div class="container">
  <h1 class="page-title">{pageTitle}</h1>
</div>
<div class="sub-hero">
  {image && <img src={image} alt="" loading="eager" />}
  <div class="sub-hero__panel">
    <h2 set:html={heroTitle} />
  </div>
</div>

<style>
  .page-title {
    font-size: clamp(1.6rem, 1.4rem + 1vw, 2rem);
    margin-block: 1.6em 0.9em;
  }
  .sub-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .sub-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sub-hero__panel {
    background: #837a78;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
    min-height: 260px;
  }
  .sub-hero__panel h2 {
    color: #fff;
    text-align: center;
    margin: 0;
    max-width: 14em;
  }
  @media (max-width: 780px) {
    .sub-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
