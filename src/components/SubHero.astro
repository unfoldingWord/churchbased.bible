---
/** Subpage opener: big page title on white, then a full-bleed split hero —
 *  photo on one side, warm-gray panel with a white heading on the other. */
interface Props {
  pageTitle: string;
  heroTitle: string;
  image?: string | null;
}
const { pageTitle, heroTitle, image } = Astro.props;
---

{/* Title spacing and sizes match the source: 39px title with a tall band
    above and a short gap below; 39px panel heading. */}
<div class="mx-auto max-w-content px-7">
  <h1 class="mt-[3.4em] mb-[0.7em] text-2xl">{pageTitle}</h1>
</div>
<div class="grid grid-cols-1 md:grid-cols-2">
  {image && <img src={image} alt="" loading="eager" class="h-full w-full object-cover" />}
  <div class="flex min-h-[260px] items-center justify-center bg-taupe p-[clamp(2rem,5vw,4rem)] text-white">
    <h2 class="m-0 max-w-[14em] text-center text-2xl text-white" set:html={heroTitle} />
  </div>
</div>
