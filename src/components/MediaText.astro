---
/** Image + content split section — the workhorse block of the old Elementor
 *  design ("wp-block-media-text ... shadow-effect"). */
interface Props {
  image?: string | null;
  imageAlt?: string;
  /** Which side the media sits on at desktop widths (logical: start/end). */
  media?: 'start' | 'end';
  shadow?: boolean;
  /** Full-bleed hero variant used at the top of subpages. */
  hero?: boolean;
  /** Content-side background. */
  tone?: 'plain' | 'cream';
}
const { image, imageAlt = '', media = 'start', shadow = true, hero = false, tone = 'plain' } = Astro.props;
---

<div class:list={['media-text', `media-text--${media}`, `media-text--${tone}`, { 'media-text--shadow': shadow && !hero, 'media-text--hero': hero }]}>
  {image && (
    <figure class="media-text__media">
      <img src={image} alt={imageAlt} loading={hero ? 'eager' : 'lazy'} />
    </figure>
  )}
  <div class="media-text__content"><slot /></div>
</div>

<style>
  .media-text {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
    border-radius: 6px;
    overflow: hidden;
  }
  .media-text--shadow {
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.16);
  }
  .media-text--end .media-text__media {
    order: 2;
  }
  .media-text__media {
    margin: 0;
    min-height: 100%;
  }
  .media-text__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media-text__content {
    padding: clamp(1.5rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .media-text--cream .media-text__content {
    background: var(--color-tertiary);
  }
  .media-text--hero {
    border-radius: 0;
    box-shadow: none;
  }
  .media-text--hero .media-text__content {
    background: var(--color-tertiary);
  }
  @media (max-width: 780px) {
    .media-text {
      grid-template-columns: 1fr;
    }
    .media-text--end .media-text__media {
      order: 0;
    }
  }
</style>
