---
/** Image + content split section — the workhorse block of the old Elementor
 *  design ("wp-block-media-text ... shadow-effect"). */
interface Props {
  image?: string | null;
  imageAlt?: string;
  /** Which side the media sits on at desktop widths (logical: start/end). */
  media?: 'start' | 'end';
  shadow?: boolean;
  /** Full-bleed hero variant used at the top of subpages. */
  hero?: boolean;
  /** Content-side background. */
  tone?: 'plain' | 'cream';
  /** Fixed image crop (CSS aspect-ratio, e.g. "2 / 1"). When set, the image is
   *  cropped to this shape and vertically centered; the content still fills the
   *  row height so its background never leaves a gap. */
  aspect?: string;
  /** Narrow the media column to this track size (e.g. "0.6fr" or "260px"),
   *  regardless of which side the media is on. Content takes the rest. */
  mediaFrac?: string;
}
const { image, imageAlt = '', media = 'start', shadow = true, hero = false, tone = 'plain', aspect, mediaFrac } = Astro.props;
const style = [aspect ? `--crop:${aspect}` : '', mediaFrac ? `--media-frac:${mediaFrac}` : '']
  .filter(Boolean)
  .join(';');

const columns = mediaFrac
  ? media === 'end'
    ? 'md:grid-cols-[1fr_var(--media-frac)]'
    : 'md:grid-cols-[var(--media-frac)_1fr]'
  : 'md:grid-cols-2';
---

<div
  class:list={[
    'grid grid-cols-1 items-stretch overflow-hidden rounded-md',
    columns,
    shadow && !hero && 'shadow-[0_12px_32px_rgb(0_0_0/0.16)]',
    hero && 'rounded-none shadow-none',
  ]}
  style={style || undefined}
>
  {
    image && (
      <figure class:list={['m-0', media === 'end' && 'md:order-2', aspect ? 'flex min-h-0 items-center' : 'min-h-full']}>
        <img
          src={image}
          alt={imageAlt}
          loading={hero ? 'eager' : 'lazy'}
          class:list={[
            'w-full object-cover',
            aspect ? 'h-auto [aspect-ratio:var(--crop)]' : 'h-full',
          ]}
        />
      </figure>
    )
  }
  <div
    class:list={[
      'flex flex-col justify-center p-[clamp(1.5rem,4vw,3.5rem)]',
      (tone === 'cream' || hero) && 'bg-cream-light',
    ]}
  >
    <slot />
  </div>
</div>
