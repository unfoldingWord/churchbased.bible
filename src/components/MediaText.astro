---
/** Image + content split section — the workhorse block of the old Elementor
 *  design ("wp-block-media-text ... shadow-effect"). */
interface Props {
  image?: string | null;
  imageAlt?: string;
  /** Which side the media sits on at desktop widths (logical: start/end). */
  media?: 'start' | 'end';
  shadow?: boolean;
  /** Full-bleed hero variant used at the top of subpages. */
  hero?: boolean;
  /** Content-side background. */
  tone?: 'plain' | 'cream';
  /** Fixed image crop (CSS aspect-ratio, e.g. "2 / 1"). When set, the image is
   *  cropped to this shape and vertically centered; the content still fills the
   *  row height so its background never leaves a gap. */
  aspect?: string;
  /** Narrow the media column to this track size (e.g. "0.6fr" or "260px"),
   *  regardless of which side the media is on. Content takes the rest. */
  mediaFrac?: string;
  /** Minimum card height at desktop (fill-mode cards with short text would
   *  otherwise collapse — the source keeps these at 250px). */
  minH?: string;
}
const { image, imageAlt = '', media = 'start', shadow = true, hero = false, tone = 'plain', aspect, mediaFrac, minH } = Astro.props;
const style = [
  aspect ? `--crop:${aspect}` : '',
  mediaFrac ? `--media-frac:${mediaFrac}` : '',
  minH ? `--card-min:${minH}` : '',
]
  .filter(Boolean)
  .join(';');

const columns = mediaFrac
  ? media === 'end'
    ? 'md:grid-cols-[1fr_var(--media-frac)]'
    : 'md:grid-cols-[var(--media-frac)_1fr]'
  : 'md:grid-cols-2';
---

<div
  class:list={[
    'grid grid-cols-1 items-stretch overflow-hidden rounded-md',
    columns,
    shadow && !hero && 'shadow-[0_12px_32px_rgb(0_0_0/0.16)]',
    hero && 'rounded-none shadow-none',
    // Cream cards paint the whole card, so a fixed-aspect image shorter than
    // the content never shows white around its edges.
    tone === 'cream' && 'bg-cream-light',
    minH && 'md:min-h-[var(--card-min)]',
  ]}
  style={style || undefined}
>
  {
    image && (
      <figure
        class:list={[
          'm-0',
          media === 'end' && 'md:order-2',
          // Fill mode: the image is absolutely positioned at desktop so it can
          // never drive the row height — portrait sources crop to the
          // content's height exactly like landscape ones. On mobile (stacked)
          // the figure provides its own 3:2 box instead.
          aspect ? 'flex min-h-0 items-center' : 'relative max-md:aspect-[3/2] md:min-h-full',
        ]}
      >
        <img
          src={image}
          alt={imageAlt}
          loading={hero ? 'eager' : 'lazy'}
          class:list={[
            'w-full object-cover',
            aspect ? 'h-auto [aspect-ratio:var(--crop)]' : 'h-full md:absolute md:inset-0',
          ]}
        />
      </figure>
    )
  }
  <div
    class:list={[
      'flex flex-col justify-center p-[clamp(1.5rem,4vw,3.5rem)]',
      (tone === 'cream' || hero) && 'bg-cream-light',
    ]}
  >
    <slot />
  </div>
</div>
