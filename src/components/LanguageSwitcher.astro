---
import { locales, byCode, localePath, type PageSlug } from '../i18n/config';

interface Props {
  locale: string;
  slug: PageSlug;
  label?: string;
}
const { locale, slug, label = 'Language' } = Astro.props;
const current = byCode(locale);
---

<div class="lang-switcher relative font-body text-[14px]">
  {/* The accessible name must contain the visible text ("English"), so voice
      control users saying "click English" can activate it (WCAG 2.5.3). The
      purpose is conveyed by a visually-hidden prefix rather than aria-label. */}
  <button
    class="peer flex cursor-pointer items-center gap-2 border-0 bg-[#fdfaf4] px-3.5 py-1 text-ink"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <span class="sr-only">{label}:</span>
    <span>{current.name}</span>
    <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true">
      <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
    </svg>
  </button>
  <ul
    class="absolute end-0 top-full z-60 m-0 hidden max-h-[70vh] min-w-[12em] list-none overflow-y-auto bg-[#fdfaf4] py-1 shadow-[0_8px_24px_rgb(0_0_0/0.18)] peer-aria-expanded:block"
  >
    {
      locales.map((l) => (
        <li>
          <a
            href={localePath(l.code, slug)}
            lang={l.tag}
            dir={l.dir}
            aria-current={l.code === locale ? 'true' : undefined}
            class:list={[
              'block px-4 py-1.5 whitespace-nowrap no-underline hover:bg-cream-light',
              // Mark the active language without relying on colour alone.
              'aria-[current=true]:font-semibold aria-[current=true]:before:content-["✓_"]',
              l.dir === 'rtl' && 'text-right',
            ]}
          >
            {l.name}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.lang-switcher').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('button[aria-haspopup]');
    if (!toggle) return;

    const close = (returnFocus = false) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      toggle.setAttribute('aria-expanded', 'false');
      if (returnFocus) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
    });

    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close(true);
    });

    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) close();
    });
  });
</script>
