---
import { localePath } from '../i18n/config';

interface Props {
  locale: string;
  ui: any;
}
const { locale, ui } = Astro.props;
---

<footer class="mt-sect bg-ink py-sect text-white">
  <div class="mx-auto max-w-content px-7">
    <p class="mb-[0.4em] font-heading text-lg font-bold">
      <a href={localePath(locale, 'home')} class="text-inherit no-underline">{ui.siteTitle}</a>
    </p>
    <p class="text-base opacity-90" set:html={ui.footer.tagline} />
    <p class="mt-4 max-w-[34em] text-sm opacity-75" set:html={ui.footer.description} />
  </div>
</footer>
