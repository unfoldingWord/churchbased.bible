---
import { localePath } from '../i18n/config';

interface Props {
  locale: string;
  ui: any;
}
const { locale, ui } = Astro.props;
const CONTACT_EMAIL = 'churchbased.bible@unfoldingword.org';
const stayConnected = ui.strings?.stayConnected ?? 'Stay Connected';
const stayConnectedBody =
  ui.strings?.stayConnectedBody ??
  'Looking for more information or help getting started? Send us an email at:';
---

<footer class="bg-ink py-sect text-white">
  <div class="mx-auto grid max-w-content grid-cols-1 gap-card px-7 md:grid-cols-[7fr_3fr]">
    <div>
      <p class="mb-[0.4em] font-heading text-lg font-bold">
        <a href={localePath(locale, 'home')} class="text-inherit no-underline">{ui.siteTitle}</a>
      </p>
      <p class="text-base opacity-90" set:html={ui.footer.tagline} />
      <p class="mt-4 max-w-[44em] text-sm opacity-75" set:html={ui.footer.description} />
    </div>
    <div>
      <p class="mb-[0.4em] font-heading text-lg font-bold">{stayConnected}</p>
      <p class="text-sm opacity-90">
        {stayConnectedBody}
        <a href={`mailto:${CONTACT_EMAIL}`} class="underline underline-offset-4">{CONTACT_EMAIL}</a>
      </p>
    </div>
  </div>
</footer>
