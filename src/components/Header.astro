---
import { localePath, type PageSlug } from '../i18n/config';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: string;
  ui: any;
  slug: PageSlug;
  /** overlay = transparent, sits on top of a hero cover (homepage). */
  variant?: 'solid' | 'overlay';
}
const { locale, ui, slug, variant = 'solid' } = Astro.props;
const homeHref = localePath(locale, 'home');
const menuLabel = ui.strings?.menuLabel ?? 'Menu';
const closeLabel = ui.strings?.close ?? 'Close';
---

{
  variant === 'solid' && (
    <div class="max-nav:hidden bg-cream py-1.5 text-center">
      <p class="m-0 text-[12px]" set:html={ui.footer.tagline} />
    </div>
  )
}
<div class="absolute end-[5%] top-0 z-50"><LanguageSwitcher locale={locale} slug={slug} label={ui.strings?.languageLabel ?? 'Language'} /></div>

<header
  class:list={[
    'flex items-center justify-between gap-7 px-[5%] pt-7 pb-6 font-heading',
    variant === 'solid' ? 'bg-ink' : 'absolute inset-x-0 top-0 z-40 bg-transparent pt-[52px]',
  ]}
>
  <p class="m-0 flex-none text-[clamp(1.4rem,1.1rem+0.9vw,1.75rem)] leading-[1.1] font-bold whitespace-nowrap">
    <a href={homeHref} class="inline-flex items-center gap-[0.6em] text-white no-underline">
      <img class="w-12 flex-none" src="/images/uploads/2025/11/CBBT-Logo.png" alt="" width="48" height="48" />
      <span>{ui.siteTitle}</span>
    </a>
  </p>
  <nav class="site-nav" aria-label="Main">
    <button
      class="peer nav:hidden cursor-pointer border-0 bg-transparent p-1 text-white"
      aria-expanded="false"
      aria-controls="site-nav-menu"
      aria-label={menuLabel}
    >
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
    </button>
    <div
      id="site-nav-menu"
      class="nav:contents max-nav:bg-ink max-nav:peer-aria-expanded:flex hidden max-nav:fixed max-nav:inset-0 max-nav:z-70 max-nav:flex-col max-nav:items-center max-nav:justify-center max-nav:gap-[1.4em]"
      aria-label={menuLabel}
    >
      <button
        class="site-nav__close nav:hidden max-nav:absolute max-nav:end-[5%] max-nav:top-6 cursor-pointer border-0 bg-transparent p-1 text-white"
        aria-label={closeLabel}
      >
        <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
      <ul class="m-0 flex list-none gap-[1.5em] p-0 max-nav:flex-col max-nav:items-center max-nav:gap-[1.4em] max-nav:text-xl">
        {
          // The contact page is gone — its email lives in the footer instead.
          ui.nav.filter((item: { href: string }) => item.href !== '/contact/').map((item: { label: string; href: string }) => {
            const href = item.href === '/' ? homeHref : localePath(locale, item.href.replaceAll('/', '') as PageSlug);
            const current = item.href === `/${slug === 'home' ? '' : slug + '/'}`;
            return (
              <li>
                <a
                  href={href}
                  aria-current={current ? 'page' : undefined}
                  class="text-[17px] font-semibold whitespace-nowrap text-white no-underline underline-offset-[6px] hover:underline aria-[current=page]:underline"
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  document.querySelectorAll<HTMLElement>('.site-nav').forEach((nav) => {
    const openBtn = nav.querySelector<HTMLButtonElement>('[aria-controls="site-nav-menu"]');
    const closeBtn = nav.querySelector<HTMLButtonElement>('.site-nav__close');
    const panel = nav.querySelector<HTMLElement>('#site-nav-menu');
    if (!openBtn || !panel) return;

    const focusable = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      ).filter((el) => el.offsetParent !== null);

    const open = () => {
      openBtn.setAttribute('aria-expanded', 'true');
      panel.setAttribute('role', 'dialog');
      panel.setAttribute('aria-modal', 'true');
      document.body.style.overflow = 'hidden';
      focusable()[0]?.focus();
    };

    const close = (returnFocus = true) => {
      if (openBtn.getAttribute('aria-expanded') !== 'true') return;
      openBtn.setAttribute('aria-expanded', 'false');
      panel.removeAttribute('role');
      panel.removeAttribute('aria-modal');
      document.body.style.overflow = '';
      if (returnFocus) openBtn.focus();
    };

    openBtn.addEventListener('click', () =>
      openBtn.getAttribute('aria-expanded') === 'true' ? close() : open()
    );
    closeBtn?.addEventListener('click', () => close());

    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key !== 'Tab') return;
      // Trap focus within the open dialog.
      const items = focusable();
      if (!items.length) return;
      const first = items[0];
      const last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    // If the viewport grows back to desktop while open, reset cleanly.
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 1152) close(false);
    });
  });
</script>
