---
// Headings for every locale — matches the old site.
import '@fontsource-variable/plus-jakarta-sans';
// Non-Latin script faces are NOT imported here: bundling them put ~250 KB of
// @font-face rules (92% of it Noto Sans SC) into a render-blocking stylesheet
// on all 16 locales. They're emitted per script into public/fonts/ by
// scripts/build-font-css.mjs and <link>ed below for the current locale only.
import '../styles/global.css';
import { locales, byCode, defaultLocale, localePath, fontPackFor, type PageSlug } from '../i18n/config';
import { content } from '../i18n/content';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  locale: string;
  slug: PageSlug;
  title: string;
  description?: string;
  /** Homepage renders its own hero-integrated header. */
  bareHeader?: boolean;
}

const { locale, slug, title, description, bareHeader = false } = Astro.props;
const def = byCode(locale);
const ui = content(locale, 'ui');
const canonical = new URL(localePath(locale, slug), Astro.site);
const fontPack = fontPackFor(locale);

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: ui.siteTitle,
  url: Astro.site!.toString(),
  logo: new URL('/images/uploads/2025/11/CBBT-Logo.png', Astro.site).toString(),
  description: ui.footer.description.replace(/<[^>]+>/g, ''),
};
---

<html lang={def.tag} dir={def.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/images/uploads/2025/11/CBBT-Logo.png" type="image/png" />
    {/* Only this locale's script font, not all six. */}
    {fontPack && <link rel="stylesheet" href={fontPack} />}
    {
      locales.map((l) => (
        <link
          rel="alternate"
          hreflang={l.tag}
          href={new URL(localePath(l.code, slug), Astro.site)}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(defaultLocale, slug), Astro.site)}
    />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/uploads/2025/11/CBBT-Website-Cover.jpg', Astro.site)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <slot name="head" />
    {/* Cloudflare Web Analytics (cookieless) is injected at the edge by the
        dashboard setting — no beacon snippet needed here. */}
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:start-4 focus:top-4 focus:z-100 focus:rounded-full focus:bg-cream focus:px-5 focus:py-2 focus:font-heading focus:font-semibold focus:text-ink"
    >
      {ui.strings?.skipToContent ?? 'Skip to content'}
    </a>
    {!bareHeader && <Header locale={locale} ui={ui} slug={slug} />}
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} ui={ui} />
  </body>
</html>
