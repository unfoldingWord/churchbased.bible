---
// Cloudflare serves /404.html for any unknown path, across all locales,
// so this single page offers every language's home link.
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { locales, localePath } from '../i18n/config';
import { content } from '../i18n/content';

const ui = content('en', 'ui');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{ui.strings.notFoundTitle} – {ui.siteTitle}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/images/uploads/2025/11/CBBT-Logo.png" type="image/png" />
  </head>
  <body>
    <main class="flex min-h-screen flex-col items-center justify-center bg-cream-light p-card text-center">
      <img src="/images/uploads/2025/11/CBBT-Logo.png" alt="" width="72" height="72" class="mb-7 invert" />
      <h1>{ui.strings.notFoundTitle}</h1>
      <p>{ui.strings.notFoundBody}</p>
      <p><a class="button" href="/">{ui.strings.backHome}</a></p>
      <nav aria-label="Languages" class="mt-card flex max-w-[40em] flex-wrap justify-center gap-x-5 gap-y-1.5 text-[14px]">
        {
          locales.map((l) => (
            <a href={localePath(l.code, 'home')} lang={l.tag} dir={l.dir}>
              {l.name}
            </a>
          ))
        }
      </nav>
    </main>
  </body>
</html>
